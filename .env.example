# Groq (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# NewsAPI (free at newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Pinecone (free at pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=stock-research-agent

# Upstash Redis (free at upstash.com)
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Neo4j (optional: graph relationships)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Qdrant (optional: vector retrieval backend)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
